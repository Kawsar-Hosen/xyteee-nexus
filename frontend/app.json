{
  "expo": {
    "name": "Nexus",
    "slug": "xyteee-nexus",
    "version": "3.10.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["xyteeenexus", "com.googleusercontent.apps.940343114841-mj0qgb95o1cjsud59j4isb6tp4jm6v2h"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xyteee.nexus",
      "associatedDomains": ["applinks:xyteee.com"],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose photos to share and post as stories",
        "NSCameraUsageDescription": "Take photos for your profile and stories",
        "NSMicrophoneUsageDescription": "Record voice messages in chat"
      },
      "bitcode": false
    },
    "android": {
      "package": "com.xyteee.nexus",
      "googleServicesFile": "./google-services.json",
      "versionCode": 13000,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#070709"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "xyteee.com",
              "pathPrefix": "/user"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "XYTEEE Nexus",
      "shortName": "Nexus",
      "description": "A serene, real-time space for the people who matter most. Private chat, stories, circles, voice and video calls on XYTEEE Nexus.",
      "lang": "en",
      "themeColor": "#070709",
      "backgroundColor": "#070709"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to share and post as stories"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D4A84F",
          "defaultChannel": "default"
        }
      ],
      "expo-audio",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-asset",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ccc0437-b948-427d-af36-0c12307f209a"
      }
    },
    "owner": "xytee"
  }
}
